# Python bytecode
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Synthetic datasets — regenerated automatically when the schema_version bumps
data/
data_analog/
data_mixed/
data_smoke*/
# Real-netlist graph dataset — rebuilt from benchmarks/ via build_real_dataset.py
data_real/
checkpoints_real/

# Trained model artifacts — retrain from source. To share a checkpoint,
# explicitly `git add -f checkpoints/<name>.pt`.
checkpoints/

# OS / editor cruft
.DS_Store
.vscode/
.idea/
*.swp

# Streamlit
.streamlit/

# Local benchmark logs
results/master_run.log

# Persistent vector stores (RAG knowledge / circuit-embedding index)
netsta_vectordb/
circuit_embeddb/

# pytest / coverage artifacts
.coverage
coverage.xml
.pytest_cache/

# Source archives — extract into the repo, don't commit them
*.zip

# Third-party benchmark netlists (fetched by scripts/fetch_benchmarks.sh)
benchmarks/

# Live serving endpoint URL (machine-local)
.vllm_url.txt
