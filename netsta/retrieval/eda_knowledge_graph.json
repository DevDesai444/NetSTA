      {"name": "clock_tree_balancing", "action": "Rebalance the clock tree to equalize insertion delay.", "estimated_effort": "medium", "applicable_process_nodes": ["45nm", "130nm"]},
      {"name": "cell_spreading", "action": "Spread cells in the dense region to relieve routing demand.", "estimated_effort": "medium", "applicable_process_nodes": ["45nm", "130nm"]},
      {"name": "layer_promotion", "action": "Promote congested nets to higher, wider metal layers.", "estimated_effort": "medium", "applicable_process_nodes": ["45nm"]},
      {"name": "filler_insertion", "action": "Insert filler/decap cells to meet local density rules.", "estimated_effort": "low", "applicable_process_nodes": ["45nm", "130nm"]},
      {"name": "net_shielding", "action": "Shield a sensitive net with grounded neighbours to cut coupling.", "estimated_effort": "medium", "applicable_process_nodes": ["45nm", "130nm"]},
      {"name": "guard_ring", "action": "Add a guard ring to isolate substrate coupling around a device.", "estimated_effort": "medium", "applicable_process_nodes": ["130nm"]},
      {"name": "miller_compensation", "action": "Add/resize the Miller cap (and nulling resistor) for stability.", "estimated_effort": "medium", "applicable_process_nodes": ["130nm"]},
      {"name": "increase_tail_current", "action": "Raise the tail bias to boost gm and bandwidth.", "estimated_effort": "low", "applicable_process_nodes": ["130nm"]},
