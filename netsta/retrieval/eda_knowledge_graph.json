    "FixStrategy": [
      {"name": "gate_upsizing", "action": "Increase drive strength on the critical cell to cut its stage delay.", "estimated_effort": "low", "applicable_process_nodes": ["45nm", "130nm"]},
      {"name": "buffer_insertion", "action": "Insert buffers to break a long net or fix a slow transition.", "estimated_effort": "low", "applicable_process_nodes": ["45nm", "130nm"]},
      {"name": "vt_swap", "action": "Swap critical cells to a lower-Vt variant for speed (at leakage cost).", "estimated_effort": "low", "applicable_process_nodes": ["45nm"]},
      {"name": "useful_skew", "action": "Intentionally skew the capture clock to borrow time across a stage.", "estimated_effort": "medium", "applicable_process_nodes": ["45nm", "130nm"]},
      {"name": "path_restructuring", "action": "Re-balance logic depth on the failing path (e.g. tree vs chain).", "estimated_effort": "high", "applicable_process_nodes": ["45nm", "130nm"]},
